# server/.env 로 복사한 뒤 값을 채우십시오. .env 는 git 에 올라가지 않습니다.
# (권장) python -m scripts.setup_env 를 실행하면 질문에 답하는 것만으로 .env 가 만들어집니다.

# DB 종류: sqlite(테스트·단일 PC, 설치 불필요) | mysql(운영)
DB_ENGINE=sqlite
# SQLITE_PATH=storage/kakao_collector.db

# --- 아래 DB_* 는 DB_ENGINE=mysql 일 때만 사용 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kakao_app
DB_PASS=change-me
DB_NAME=kakao_collector

# Android 앱 설정 화면에 같은 값을 입력합니다. 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

APP_TIMEZONE=Asia/Seoul
MAX_IMAGE_MB=10
# MEDIA_ROOT=/var/lib/kakao-collector/media

# 관리자 웹(/admin) 로그인. ADMIN_PASSWORD 가 비어 있으면 관리자 웹은 비활성입니다.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_HOURS=12
# ADMIN_SESSION_SECRET=   # 미지정 시 API_KEY·ADMIN_PASSWORD 에서 유도

# 민원 분류 (Google Gemini). 비어 있으면 자동 분류 안 함
# GEMINI_API_KEY=

# 업체 문자 발송 (뿌리오 연동). 뿌리오 > 연동 > 연동신청관리에서 이 서버의 공인 IP 를 등록하고 인증키를 발급받습니다.
# 발신번호·문구·사용 여부는 관리자 웹 '문자 발송' 탭에서 설정합니다.
# PPURIO_ACCOUNT=뿌리오아이디
# PPURIO_API_KEY=발급받은인증키
