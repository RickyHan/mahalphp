<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="16dp">

    <RadioGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/modeAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_mode_all" />

        <RadioButton
            android:id="@+id/modeOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_mode_only" />

        <RadioButton
            android:id="@+id/modeExcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_mode_except" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:text="@string/room_filter_hint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/manualRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/room_manual_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/addRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/roomListTitle"
        style="@android:style/TextAppearance.Material.Subhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/roomList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice" />

    <TextView
        android:id="@+id/emptyRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/room_empty"
        android:visibility="gone" />

    <Button
        android:id="@+id/saveRooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save" />
</LinearLayout>
