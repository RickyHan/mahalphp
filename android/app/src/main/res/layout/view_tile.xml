<?xml version="1.0" encoding="utf-8"?>
<!-- 바둑판 메뉴 타일 하나: 색 그라데이션 배경 + 아이콘 + 제목 + 상태 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="128dp"
    android:padding="16dp">

    <TextView
        android:id="@+id/tileIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/tile_icon_bg"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tileBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:background="@drawable/tile_badge_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="56dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tileSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.88"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
