<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Collector.WithBar">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Collector"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <activity
            android:name=".RoomFilterActivity"
            android:exported="false"
            android:label="@string/room_filter_title" />

        <activity
            android:name=".ServerActivity"
            android:exported="false"
            android:label="@string/section_server"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OptionsActivity"
            android:exported="false"
            android:label="@string/section_options" />

        <activity
            android:name=".RecentActivity"
            android:exported="false"
            android:label="@string/section_recent" />

        <receiver
            android:name=".CaptureToggleReceiver"
            android:exported="false" />

        <service
            android:name=".KakaoNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
